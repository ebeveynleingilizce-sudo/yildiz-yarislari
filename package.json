{
  "name": "yildiz-yarislari",
  "version": "1.0.0",
  "description": "Öğretmen ve öğrenciler için Firebase Realtime Database ile eşitlenen yıldız yarışı uygulaması.",
  "main": "firebase-config.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --project=android-small --project=android-standard --project=iphone-webkit",
    "test:webkit": "playwright test --project=iphone-webkit --project=tablet",
    "test:desktop": "playwright test --project=desktop",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebeveynleingilizce-sudo/yildiz-yarislari.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ebeveynleingilizce-sudo/yildiz-yarislari/issues"
  },
  "homepage": "https://github.com/ebeveynleingilizce-sudo/yildiz-yarislari#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
