{
  "rules": {
    ".read": false,
    ".write": false,
    "teacherData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null"
      }
    },
    "testTeacherData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.email != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email != null"
      }
    },
    "sharedRosters": {
      "$token": {
        ".read": "auth != null && ((root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && root.child('sharedRosters').child($token).child('ownerUid').val() === auth.uid || (root.child('studentSessions').child($token).child(auth.uid).hasChildren(['studentId', 'accessCode']) && root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).isString() && root.child('studentSessions').child($token).child(auth.uid).child('accessCode').val() === root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).val()))",
        ".write": "auth != null && (root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && ((!newData.exists() && data.child('ownerUid').val() === auth.uid) || (auth.uid === newData.child('ownerUid').val() && (!data.exists() || data.child('ownerUid').val() === auth.uid)))"
      }
    },
    "studentCredentials": {
      "$token": {
        ".read": "auth != null && (root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && data.child('ownerUid').val() === auth.uid",
        ".write": "auth != null && (root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && ((!newData.exists() && data.child('ownerUid').val() === auth.uid) || (auth.uid === newData.child('ownerUid').val() && (!data.exists() || data.child('ownerUid').val() === auth.uid)))"
      }
    },
    "studentSessions": {
      "$token": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('sharedRosters').child($token).exists() && newData.child('studentId').isString() && newData.child('accessCode').isString() && newData.child('accessCode').val() === root.child('studentCredentials').child($token).child('codes').child(newData.child('studentId').val()).val() && root.child('studentCredentials').child($token).child('codes').child(newData.child('studentId').val()).isString()"
        }
      }
    },
    "class-race": {
      "defaultRosterToken": {
        ".read": false,
        ".write": "auth != null && auth.token.email === 'tunc@test.com'"
      },
      "students": {
        ".read": "auth != null && auth.token.email === 'tunc@test.com'",
        ".write": false
      }
    },
    "studentQuestionData": {
      "$token": {
        ".read": "auth != null && (root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && root.child('sharedRosters').child($token).child('ownerUid').val() === auth.uid",
        "$studentId": {
          ".read": "auth != null && ((root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString()) && root.child('sharedRosters').child($token).child('ownerUid').val() === auth.uid || (root.child('studentSessions').child($token).child(auth.uid).child('studentId').val() === $studentId && root.child('studentSessions').child($token).child(auth.uid).hasChildren(['studentId', 'accessCode']) && root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).isString() && root.child('studentSessions').child($token).child(auth.uid).child('accessCode').val() === root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).val()))",
          ".write": "auth != null && root.child('studentSessions').child($token).child(auth.uid).child('studentId').val() === $studentId && root.child('studentSessions').child($token).child(auth.uid).hasChildren(['studentId', 'accessCode']) && root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).isString() && root.child('studentSessions').child($token).child(auth.uid).child('accessCode').val() === root.child('studentCredentials').child($token).child('codes').child(root.child('studentSessions').child($token).child(auth.uid).child('studentId').val()).val() && root.child('sharedRosters').child($token).exists()"
        },
        ".write": "auth != null && root.child('teacherData').child(auth.uid).child('classTokens').child($token).isString() && root.child('sharedRosters').child($token).child('ownerUid').val() === auth.uid"
      }
    }
  }
}
