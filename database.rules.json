{
  "rules": {
    ".read": false,
    ".write": false,
    "teacherData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "testTeacherData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sharedRosters": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === newData.child('ownerUid').val() && root.child('teacherData').child(auth.uid).child('shareToken').val() === $token"
      }
    },
    "studentCredentials": {
      "$token": {
        ".read": "auth != null && root.child('teacherData').child(auth.uid).child('shareToken').val() === $token",
        ".write": "auth != null && root.child('teacherData').child(auth.uid).child('shareToken').val() === $token && newData.child('ownerUid').val() === auth.uid"
      }
    },
    "studentSessions": {
      "$token": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('sharedRosters').child($token).exists() && newData.child('studentId').isString() && newData.child('accessCode').isString() && newData.child('accessCode').val() === root.child('studentCredentials').child($token).child('codes').child(newData.child('studentId').val()).val()"
        }
      }
    },
    "class-race": {
      "defaultRosterToken": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'tunc@test.com'"
      },
      "students": {
        ".read": "auth != null && auth.token.email === 'tunc@test.com'",
        ".write": false
      }
    },
    "studentQuestionData": {
      "$token": {
        ".read": "auth != null && root.child('teacherData').child(auth.uid).child('shareToken').val() === $token",
        "$studentId": {
          ".read": "auth != null && (root.child('teacherData').child(auth.uid).child('shareToken').val() === $token || root.child('studentSessions').child($token).child(auth.uid).child('studentId').val() === $studentId)",
          ".write": "auth != null && root.child('studentSessions').child($token).child(auth.uid).child('studentId').val() === $studentId && root.child('sharedRosters').child($token).exists()"
        }
      }
    }
  }
}
